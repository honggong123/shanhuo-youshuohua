<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: 0 }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 14, height: 720, background: '#0E3F8C' }} />

    <Box style={{ position: 'relative', paddingTop: 62, paddingLeft: 96, paddingRight: 96, flexDirection: 'column' }}>

        {/* 页眉 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 30 }}>
            <Box style={{ width: 6, height: 32, background: '#1E4FA8', borderRadius: 3 }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 2 }}>现场演示：六步走完全流程</Text>
        </Box>

        {/* 演示路线 */}
        <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 18, marginBottom: 26 }}>

            <Box style={{ width: 520, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22 }}>
                <Box style={{ width: 40, height: 40, background: '#1E4FA8', borderRadius: 20, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>打开小程序 / 网页</Text>
                    <Text style={{ fontSize: 14, color: '#6B7A90' }}>展示首页与作品入口</Text>
                </Box>
            </Box>

            <Box style={{ width: 520, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22 }}>
                <Box style={{ width: 40, height: 40, background: '#2E6FC7', borderRadius: 20, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>注册 / 登录</Text>
                    <Text style={{ fontSize: 14, color: '#6B7A90' }}>演示账号体系与历史记录</Text>
                </Box>
            </Box>

            <Box style={{ width: 520, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22 }}>
                <Box style={{ width: 40, height: 40, background: '#3D7BD9', borderRadius: 20, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>3</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>拍照上传山货</Text>
                    <Text style={{ fontSize: 14, color: '#6B7A90' }}>现场用手机拍一张实拍图</Text>
                </Box>
            </Box>

            <Box style={{ width: 520, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22 }}>
                <Box style={{ width: 40, height: 40, background: '#4A8CE0', borderRadius: 20, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>4</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>AI 识别建档</Text>
                    <Text style={{ fontSize: 14, color: '#6B7A90' }}>展示结构化识别结果</Text>
                </Box>
            </Box>

            <Box style={{ width: 520, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22 }}>
                <Box style={{ width: 40, height: 40, background: '#0E3F8C', borderRadius: 20, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>5</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>生成五件套</Text>
                    <Text style={{ fontSize: 14, color: '#6B7A90' }}>文案 / 海报 / 语音 / 脚本 / 定价</Text>
                </Box>
            </Box>

            <Box style={{ width: 520, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FDF8F7', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22 }}>
                <Box style={{ width: 40, height: 40, background: '#D9534F', borderRadius: 20, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>6</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#B3413D' }}>播放语音 / 下载海报</Text>
                    <Text style={{ fontSize: 14, color: '#6B5A59' }}>现场听讲解、看成品</Text>
                </Box>
            </Box>

        </Box>

        {/* 提示条 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, justifyContent: 'center', marginTop: 8 }}>
            <Box style={{ width: 6, height: 6, background: '#D9534F', borderRadius: 3 }} />
            <Text style={{ fontSize: 17, color: '#0E3F8C', fontWeight: 600 }}>
                演示全程使用线上环境，模型不可用时自动降级，保证零失误
            </Text>
        </Box>

    </Box>
</Slide>
