<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: 0 }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 14, height: 720, background: '#0E3F8C' }} />

    <Box style={{ position: 'relative', paddingTop: 66, paddingLeft: 96, paddingRight: 96, flexDirection: 'column' }}>

        {/* 页眉 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 34 }}>
            <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3 }} />
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 2 }}>真实痛点：好货出不去，风景讲不出</Text>
        </Box>

        {/* 双栏对照 */}
        <Box style={{ flexDirection: 'row', gap: 32 }}>

            {/* 痛点 A */}
            <Box style={{ width: 528, background: '#F7F9FC', borderRadius: 12, paddingLeft: 32, paddingRight: 32, paddingTop: 28, paddingBottom: 28, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 18 }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>A</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>农产品营销能力缺失</Text>
                </Box>

                <Box style={{ width: 60, height: 3, background: '#1E4FA8', marginBottom: 20 }} />

                <Box style={{ flexDirection: 'column', gap: 14 }}>
                    <Box style={{ flexDirection: 'row', gap: 10 }}>
                        <Text style={{ fontSize: 16, color: '#1E4FA8', fontWeight: 'bold' }}>·</Text>
                        <Text style={{ fontSize: 17, color: '#3A4658', lineHeight: 1.6 }}>农户普遍不具备拍摄、文案、美工能力</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10 }}>
                        <Text style={{ fontSize: 16, color: '#1E4FA8', fontWeight: 'bold' }}>·</Text>
                        <Text style={{ fontSize: 17, color: '#3A4658', lineHeight: 1.6 }}>优质山货"有实无名"，缺包装、缺传播素材</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10 }}>
                        <Text style={{ fontSize: 16, color: '#1E4FA8', fontWeight: 'bold' }}>·</Text>
                        <Text style={{ fontSize: 17, color: '#3A4658', lineHeight: 1.6 }}>雇专业团队成本高，单次拍摄动辄数千元</Text>
                    </Box>
                </Box>

                <Box style={{ background: '#E8F0FB', borderRadius: 8, paddingLeft: 18, paddingRight: 18, paddingTop: 14, paddingBottom: 14, marginTop: 22 }}>
                    <Text style={{ fontSize: 17, color: '#0E3F8C', fontWeight: 600 }}>好货没有好包装，卖不上好价钱</Text>
                </Box>
            </Box>

            {/* 痛点 B */}
            <Box style={{ width: 528, background: '#FDF8F7', borderRadius: 12, paddingLeft: 32, paddingRight: 32, paddingTop: 28, paddingBottom: 28, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 18 }}>
                    <Box style={{ width: 34, height: 34, background: '#D9534F', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>B</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>乡村文旅讲解人才稀缺</Text>
                </Box>

                <Box style={{ width: 60, height: 3, background: '#D9534F', marginBottom: 20 }} />

                <Box style={{ flexDirection: 'column', gap: 14 }}>
                    <Box style={{ flexDirection: 'row', gap: 10 }}>
                        <Text style={{ fontSize: 16, color: '#D9534F', fontWeight: 'bold' }}>·</Text>
                        <Text style={{ fontSize: 17, color: '#3A4658', lineHeight: 1.6 }}>村落旅游讲不出文化故事，游客"走马观花"</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10 }}>
                        <Text style={{ fontSize: 16, color: '#D9534F', fontWeight: 'bold' }}>·</Text>
                        <Text style={{ fontSize: 17, color: '#3A4658', lineHeight: 1.6 }}>专业讲解员培养周期长、留不住、覆盖难</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10 }}>
                        <Text style={{ fontSize: 16, color: '#D9534F', fontWeight: 'bold' }}>·</Text>
                        <Text style={{ fontSize: 17, color: '#3A4658', lineHeight: 1.6 }}>解说内容同质化，缺少个性化、可持续供给</Text>
                    </Box>
                </Box>

                <Box style={{ background: '#FBECEB', borderRadius: 8, paddingLeft: 18, paddingRight: 18, paddingTop: 14, paddingBottom: 14, marginTop: 22 }}>
                    <Text style={{ fontSize: 17, color: '#B3413D', fontWeight: 600 }}>看得到风景，听不到故事</Text>
                </Box>
            </Box>

        </Box>

        {/* 底部小结 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginTop: 30, justifyContent: 'center' }}>
            <Box style={{ width: 28, height: 1, background: '#C8D3E2' }} />
            <Text style={{ fontSize: 18, color: '#6B7A90', letterSpacing: 1 }}>
                两个痛点，同一个根源：<Text style={{ fontSize: 18, color: '#0E3F8C', fontWeight: 'bold' }}>内容生产能力不足</Text>
            </Text>
            <Box style={{ width: 28, height: 1, background: '#C8D3E2' }} />
        </Box>

    </Box>
</Slide>
