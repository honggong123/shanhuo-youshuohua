<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: 0 }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 14, height: 720, background: '#0E3F8C' }} />

    <Box style={{ position: 'relative', paddingTop: 62, paddingLeft: 96, paddingRight: 96, flexDirection: 'column' }}>

        {/* 页眉 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 30 }}>
            <Box style={{ width: 6, height: 32, background: '#1E4FA8', borderRadius: 3 }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 2 }}>四项支撑技术</Text>
        </Box>

        {/* 2×2 矩阵 */}
        <Box style={{ flexDirection: 'row', gap: 26, marginBottom: 24 }}>

            <Box style={{ width: 531, background: '#F5F8FD', borderRadius: 12, paddingTop: 24, paddingBottom: 24, paddingLeft: 28, paddingRight: 28, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
                    <Box style={{ width: 32, height: 32, background: '#1E4FA8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>01</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>结构化多模态识图</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
                    用提示词约束模型必须输出 JSON 结构，让"看懂图片"变成"可直接入库的数据"。
                </Text>
            </Box>

            <Box style={{ width: 531, background: '#F5F8FD', borderRadius: 12, paddingTop: 24, paddingBottom: 24, paddingLeft: 28, paddingRight: 28, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
                    <Box style={{ width: 32, height: 32, background: '#2E6FC7', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>02</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>智能语音合成</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
                    基于 Edge-TTS 生成自然中文讲解音频，无需付费接口，毫秒级响应。
                </Text>
            </Box>

        </Box>

        <Box style={{ flexDirection: 'row', gap: 26 }}>

            <Box style={{ width: 531, background: '#F5F8FD', borderRadius: 12, paddingTop: 24, paddingBottom: 24, paddingLeft: 28, paddingRight: 28, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
                    <Box style={{ width: 32, height: 32, background: '#3D7BD9', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>03</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>双端工程化</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
                    小程序与 H5 共用同一套后端接口，前端各自优化交互，一套服务双端触达。
                </Text>
            </Box>

            <Box style={{ width: 531, background: '#FDF8F7', borderRadius: 12, paddingTop: 24, paddingBottom: 24, paddingLeft: 28, paddingRight: 28, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
                    <Box style={{ width: 32, height: 32, background: '#D9534F', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>04</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#B3413D' }}>降级兜底机制</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#6B5A59', lineHeight: 1.7 }}>
                    模型超时或额度耗尽时自动切换内置样例数据，保证演示现场零失误。
                </Text>
            </Box>

        </Box>

        {/* 底部强调 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginTop: 30, justifyContent: 'center' }}>
          <Box style={{ width: 28, height: 1, background: '#C8D3E2' }} />
          <Text style={{ fontSize: 17, color: '#6B7A90' }}>技术不是炫技，是为了让农户"真的能用起来"</Text>
          <Box style={{ width: 28, height: 1, background: '#C8D3E2' }} />
        </Box>

    </Box>
</Slide>
