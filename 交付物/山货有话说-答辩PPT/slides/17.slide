<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: 0 }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 14, height: 720, background: '#0E3F8C' }} />

    <Box style={{ position: 'relative', paddingTop: 58, paddingLeft: 96, paddingRight: 96, flexDirection: 'column' }}>

        {/* 页眉 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 26 }}>
            <Box style={{ width: 6, height: 32, background: '#1E4FA8', borderRadius: 3 }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 2 }}>创新点与价值</Text>
        </Box>

        {/* 五个创新点 */}
        <Box style={{ flexDirection: 'column', gap: 12, marginBottom: 26 }}>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 9, paddingTop: 14, paddingBottom: 14, paddingLeft: 24, paddingRight: 24 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', borderRadius: 4, paddingLeft: 9, paddingRight: 9, paddingTop: 3, paddingBottom: 3 }}>创新点 1</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 600 }}>"AI 底图 + 本地排版"中文海报方案</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>解决文生图中文乱码行业难题</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 9, paddingTop: 14, paddingBottom: 14, paddingLeft: 24, paddingRight: 24 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#2E6FC7', borderRadius: 4, paddingLeft: 9, paddingRight: 9, paddingTop: 3, paddingBottom: 3 }}>创新点 2</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 600 }}>五件套一站式并行生成</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>从素材到定价，覆盖营销全链路</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 9, paddingTop: 14, paddingBottom: 14, paddingLeft: 24, paddingRight: 24 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#3D7BD9', borderRadius: 4, paddingLeft: 9, paddingRight: 9, paddingTop: 3, paddingBottom: 3 }}>创新点 3</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 600 }}>多厂商可插拔模型网关</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>一套代码适配多家，不锁定厂商</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F8FD', borderRadius: 9, paddingTop: 14, paddingBottom: 14, paddingLeft: 24, paddingRight: 24 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#4A8CE0', borderRadius: 4, paddingLeft: 9, paddingRight: 9, paddingTop: 3, paddingBottom: 3 }}>创新点 4</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 600 }}>双端同源，小程序 + 网页共用后端</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>农户与游客各自最优触达方式</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FDF8F7', borderRadius: 9, paddingTop: 14, paddingBottom: 14, paddingLeft: 24, paddingRight: 24 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#D9534F', borderRadius: 4, paddingLeft: 9, paddingRight: 9, paddingTop: 3, paddingBottom: 3 }}>创新点 5</Text>
                <Text style={{ fontSize: 17, color: '#B3413D', fontWeight: 600 }}>定价决策延伸：从帮吆喝，到帮算账</Text>
                <Text style={{ fontSize: 15, color: '#6B5A59' }}>不止做宣传，更帮农户把钱算明白</Text>
            </Box>

        </Box>

        {/* 三方价值 */}
        <Box style={{ flexDirection: 'row', gap: 20 }}>

            <Box style={{ width: 340, background: '#EAF1FB', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>对农户</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65 }}>零成本获得专业级营销素材，好货卖出好价钱</Text>
            </Box>

            <Box style={{ width: 340, background: '#EAF1FB', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>对县域文旅</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65 }}>低成本补齐讲解能力，村落故事可长期留存复用</Text>
            </Box>

            <Box style={{ width: 340, background: '#EAF1FB', borderRadius: 10, paddingTop: 18, paddingBottom: 18, paddingLeft: 22, paddingRight: 22, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>对时代命题</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65 }}>以 AI 降低门槛，让数字技术真正下沉到乡村</Text>
            </Box>

        </Box>

    </Box>
</Slide>
