/* ============================================================
   《山货有话说》小程序全局样式
   与 H5 网页版保持同一套视觉语言：
     主色 深绿 #2b5630 / 品牌绿 #3d8042 / 亮绿 #4d9950 / 点缀金 #ee9d2b
     卡片统一「顶部渐变装饰条」，正文统一「暖白底 + 点阵纹理」
   ============================================================ */

page {
  background-color: #f4f6f1;
  /* 点阵纹理（32×32 无缝瓦片，base64 PNG —— 小程序对 SVG 支持不稳定，故用 PNG） */
  background-image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAYAAABzenr0AAAARElEQVR42mNgGAUjHTBiE5SzVxKBsR8dvPeGlg5gwmc5Nj7NHUBvMPgcgB7ntE4Do2AUjIJRMApGwSgYBaNgFIyCAQcAI2QMCpXYB3IAAAAASUVORK5CYII=");
  background-size: 64rpx 64rpx;
  font-size: 28rpx;
  color: #292524;
  -webkit-font-smoothing: antialiased;
}

/* 卡片：白底 + 柔和投影 + 顶部渐变装饰条（用 ::before 绘制，无需改结构） */
.card {
  position: relative;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(43, 86, 48, 0.06);
  overflow: hidden;
  animation: rise 0.42s ease both;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #3d8042, #71b173 55%, #ee9d2b);
}

/* 卡片进场 */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.rise-1 { animation-delay: 0.06s; }
.rise-2 { animation-delay: 0.12s; }
.rise-3 { animation-delay: 0.18s; }

/* 漂浮（装饰元素） */
@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.floaty {
  animation: floaty 6s ease-in-out infinite;
}

/* 光环扩散（上传区图标） */
@keyframes halo {
  0% { transform: scale(0.86); opacity: 0.5; }
  70% { transform: scale(1.3); opacity: 0; }
  100% { transform: scale(1.3); opacity: 0; }
}

/* 扫描线（上传区，暗示 AI 正在识别） */
@keyframes scanline {
  0% { top: 12%; opacity: 0; }
  15% { opacity: 0.9; }
  85% { opacity: 0.9; }
  100% { top: 88%; opacity: 0; }
}

/* ---------- 按钮 ---------- */

/* 小程序 button 自带 ::after 边框，统一清掉 */
button::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4d9950, #3d8042);
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  line-height: 1.4;
  box-shadow: 0 8rpx 20rpx rgba(61, 128, 66, 0.28);
}

.btn-primary[disabled] {
  opacity: 0.6;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #57534e;
  border: 2rpx solid #e7e5e4;
  border-radius: 22rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  text-align: center;
  line-height: 1.4;
}

/* ---------- 标签 ---------- */

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e7e5e4;
  color: #57534e;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
  background: #ffffff;
}

.chip-active {
  background: linear-gradient(135deg, #4d9950, #3d8042);
  border-color: #3d8042;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(61, 128, 66, 0.25);
}

.chip-disabled {
  color: #d6d3d1;
  border-color: #f5f5f4;
  background: #fafaf9;
}

/* 功能性小标签（带底色 + 描边，用于说明限制条件） */
.mini-chip {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #336737;
  background: #f2f9f1;
  border: 2rpx solid #dff0dc;
  margin: 0 10rpx 10rpx 0;
}

/* ---------- 文本 ---------- */

.title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
}

/* 标题前的渐变小竖条（替代 emoji 图标，跨机型观感一致） */
.title-bar {
  width: 8rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #4d9950, #2b5630);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.subtitle {
  font-size: 24rpx;
  color: #78716c;
}

/* ---------- 步骤标题（圆形渐变徽标 + 渐隐横线） ---------- */

.step-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #57534e;
  margin-bottom: 22rpx;
}

.step-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4d9950, #2b5630);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(61, 128, 66, 0.3), 0 0 0 6rpx rgba(61, 128, 66, 0.1);
}

.step-line {
  flex: 1;
  height: 2rpx;
  margin-left: 18rpx;
  background: linear-gradient(90deg, #c2e0be, rgba(194, 224, 190, 0));
}

/* ---------- 表单与提示 ---------- */

.input {
  background: #ffffff;
  border: 2rpx solid #e7e5e4;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.error-box {
  background: #fef2f2;
  color: #dc2626;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.loading-line {
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
  padding: 34rpx 0;
}
