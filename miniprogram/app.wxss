/* 全局样式 */
page {
  background: #f5f5f4;
  font-size: 28rpx;
  color: #292524;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background: #3d8042;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-ghost {
  background: #ffffff;
  color: #57534e;
  border: 2rpx solid #e7e5e4;
  border-radius: 20rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  text-align: center;
}

.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e7e5e4;
  color: #57534e;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.chip-active {
  background: #3d8042;
  border-color: #3d8042;
  color: #ffffff;
}

.chip-disabled {
  color: #d6d3d1;
  border-color: #f5f5f4;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
}

.subtitle {
  font-size: 24rpx;
  color: #78716c;
}

.error-box {
  background: #fef2f2;
  color: #dc2626;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.input {
  background: #ffffff;
  border: 2rpx solid #e7e5e4;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
