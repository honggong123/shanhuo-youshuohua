.hero {
  background: linear-gradient(140deg, #336737, #3d8042 60%, #4d9950);
  padding: 40rpx 32rpx 44rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.5;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.step-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #57534e;
  margin-bottom: 20rpx;
}

.pick-area {
  border: 3rpx dashed #a7c4a9;
  border-radius: 24rpx;
  background: #f2f9f1;
  text-align: center;
  padding: 70rpx 0;
}

.pick-icon {
  font-size: 70rpx;
}

.pick-text {
  margin-top: 12rpx;
  color: #3d8042;
  font-size: 28rpx;
  font-weight: 600;
}

.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.half {
  flex: 1;
}

.rec-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1917;
}

.rec-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.rec-chip {
  background: #dff0dc;
  color: #336737;
  border-radius: 14rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
}

.rec-origin {
  font-size: 22rpx;
  color: #78716c;
}

.rec-demo {
  background: #fdf3e3;
  color: #d97f16;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
}

.rec-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #57534e;
  line-height: 1.7;
}

.hl-list {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hl {
  background: #fdf3e3;
  color: #d97f16;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}

.gen-btn {
  margin-top: 24rpx;
}

.loading-line {
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.tabs {
  display: flex;
  border-bottom: 2rpx solid #f0eeec;
  margin-top: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #a8a29e;
  border-bottom: 4rpx solid transparent;
}

.tab-on {
  color: #336737;
  font-weight: 700;
  border-bottom-color: #3d8042;
}

.panel {
  padding-top: 24rpx;
  min-height: 200rpx;
}

.gen-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
}

.point {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #44403c;
}

.story {
  margin-top: 18rpx;
  background: #f2f9f1;
  border-radius: 18rpx;
  padding: 22rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #44403c;
}

.tags {
  margin-top: 14rpx;
}

.tag {
  color: #3d8042;
  font-size: 22rpx;
  margin-right: 16rpx;
}

.poster {
  width: 100%;
  border-radius: 20rpx;
}

.save-btn,
.play-btn {
  margin-top: 18rpx;
}

.scene {
  border: 2rpx solid #f0eeec;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.scene-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.scene-no {
  background: #3d8042;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-weight: 700;
}

.scene-visual {
  font-size: 22rpx;
  color: #78716c;
}

.scene-narr {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #44403c;
  line-height: 1.7;
}

.price-box {
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.price-amber {
  background: #fdf3e3;
}

.price-green {
  background: #f2f9f1;
}

.price-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #d97f16;
}

.price-green .price-label {
  color: #336737;
}

.price-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #44403c;
  line-height: 1.7;
}

.value-item {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #44403c;
}

.price-note {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #a8a29e;
}
