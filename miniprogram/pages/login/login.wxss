.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(160deg, #2b5630, #3d8042 55%, #4d9950);
  padding: 100rpx 40rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- 背景装饰层 ---------- */
.page-deco {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.pd-glow {
  position: absolute;
  border-radius: 50%;
}

.pd-glow-a {
  left: -120rpx;
  top: -140rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(255, 255, 255, 0.1);
}

.pd-glow-b {
  right: -140rpx;
  bottom: 40rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(238, 157, 43, 0.18);
}

.pd-sun {
  position: absolute;
  right: 110rpx;
  top: 150rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

/* 山峦：椭圆顶 + 负偏移，拼出层叠丘陵 */
.pd-hill {
  position: absolute;
  left: -10%;
  right: -10%;
  border-radius: 100% 100% 0 0;
}

.pd-hill-a {
  bottom: -60rpx;
  height: 260rpx;
  background: rgba(255, 255, 255, 0.08);
}

.pd-hill-b {
  left: 20%;
  right: -20%;
  bottom: -90rpx;
  height: 210rpx;
  background: rgba(255, 255, 255, 0.06);
}

.page-inner {
  position: relative;
}

/* ---------- 品牌区 ---------- */
.hero {
  text-align: center;
  color: #ffffff;
  margin-bottom: 50rpx;
}

/* 品牌标记：绿色圆角块 + 白色气泡 + 山峦 + 太阳 */
.brand {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #4d9950, #2b5630);
  box-shadow: 0 14rpx 34rpx rgba(15, 50, 20, 0.35);
}

.brand-bubble {
  position: absolute;
  left: 24rpx;
  top: 26rpx;
  width: 92rpx;
  height: 74rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

/* 气泡尾巴 */
.brand-bubble::after {
  content: '';
  position: absolute;
  left: 16rpx;
  bottom: -14rpx;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 16rpx solid #ffffff;
}

.mtn {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
}

.mtn-a {
  left: 8rpx;
  bottom: 14rpx;
  border-left-width: 20rpx;
  border-right-width: 20rpx;
  border-bottom-width: 30rpx;
  border-left-color: transparent;
  border-right-color: transparent;
  border-bottom-color: #3d8042;
}

.mtn-b {
  left: 34rpx;
  bottom: 14rpx;
  border-left-width: 16rpx;
  border-right-width: 16rpx;
  border-bottom-width: 22rpx;
  border-left-color: transparent;
  border-right-color: transparent;
  border-bottom-color: #3d8042;
}

.brand-sun {
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ee9d2b;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

/* ---------- 表单 ---------- */
.form-card {
  margin: 0;
}

.tab-bar {
  display: flex;
  background: #f5f5f4;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #78716c;
}

.tab-active {
  background: #ffffff;
  color: #1c1917;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.submit {
  margin-top: 16rpx;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8a29e;
  line-height: 1.6;
}
