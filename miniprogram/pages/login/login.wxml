<view class="page">
  <view class="hero">
    <view class="logo">🍊</view>
    <view class="hero-title">山货有话说</view>
    <view class="hero-sub">AI 让每一份山货开口说话</view>
  </view>

  <view class="card form-card">
    <view class="tab-bar">
      <view class="tab {{tab === 'login' ? 'tab-active' : ''}}" data-tab="login" bindtap="setTab">登 录</view>
      <view class="tab {{tab === 'register' ? 'tab-active' : ''}}" data-tab="register" bindtap="setTab">注 册</view>
    </view>

    <input class="input" placeholder="用户名（2~20 个字符）" value="{{username}}" data-field="username" bindinput="onInput" />
    <input wx:if="{{tab === 'register'}}" class="input" placeholder="昵称（选填，默认同用户名）" value="{{nickname}}" data-field="nickname" bindinput="onInput" />
    <input class="input" password placeholder="{{tab === 'register' ? '密码（至少 6 位）' : '密码'}}" value="{{password}}" data-field="password" bindinput="onInput" />

    <view wx:if="{{error}}" class="error-box">⚠️ {{error}}</view>

    <button class="btn-primary submit" disabled="{{busy}}" bindtap="submit">
      {{busy ? '请稍候…' : (tab === 'login' ? '进入平台' : '注册并进入')}}
    </button>

    <view class="tip">登录后可生成山货四件套、云游乡村，创作自动存档</view>
  </view>
</view>
