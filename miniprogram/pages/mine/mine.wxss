.user-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(140deg, #2b5630, #3d8042 60%, #4d9950);
  margin: 20rpx 24rpx;
  border-radius: 28rpx;
  padding: 44rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(43, 86, 48, 0.22);
  animation: rise 0.42s ease both;
}

/* 卡片内装饰：光晕 + 丘陵水印 */
.user-deco {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.ud-glow {
  position: absolute;
  right: -70rpx;
  top: -90rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.ud-hill {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -46rpx;
  height: 130rpx;
  border-radius: 100% 100% 0 0;
  background: rgba(255, 255, 255, 0.08);
}

/* 头像：纯 CSS 人像，替代 emoji */
.avatar {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  overflow: hidden;
}

.av-head {
  position: absolute;
  left: 36rpx;
  top: 24rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
}

.av-body {
  position: absolute;
  left: 22rpx;
  top: 68rpx;
  width: 66rpx;
  height: 42rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #ffffff;
}

.user-info {
  position: relative;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.username {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.engines {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.engines .chip {
  margin: 0;
}

.mini-note {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: #a8a29e;
  line-height: 1.6;
}

.about {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #57534e;
  line-height: 1.9;
  white-space: pre-line;
}

.about-links {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #a8a29e;
  line-height: 1.8;
  word-break: break-all;
}

.logout-btn {
  background: #ffffff;
  color: #dc2626;
  border: 2rpx solid #fecaca;
  border-radius: 20rpx;
  font-size: 28rpx;
}
